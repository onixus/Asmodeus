{
  "contract": {
    "version": "1.0",
    "canonical_repo": "onixus/unified-platform",
    "canonical_commit": "878d138c560cd4106ab0d6cccde804ddc3e5ae1d"
  },
  "system": {
    "id": "asmodeus",
    "namespace": "asmodeus",
    "role": "synthetic-bas"
  },
  "ownership": {
    "authoritative_domains": [
      "synthetic-scenarios",
      "exercise-runs",
      "exercise-safety-state",
      "validation-telemetry"
    ],
    "gateway_is_source_of_truth": false,
    "clickhouse_is_transactional_source": false
  },
  "identity": {
    "accepts_apex_identity": true,
    "production_trusts_unsigned_role_header": false,
    "owning_service_authorizes_mutations": true
  },
  "resources": [
    {
      "kind": "exercise",
      "local_id_field": "scenario_id",
      "urn_prefix": "urn:apex:exercise:asmodeus:"
    },
    {
      "kind": "event",
      "local_id_field": "event_id",
      "urn_prefix": "urn:apex:event:asmodeus:"
    },
    {
      "kind": "evidence",
      "local_id_field": "audit_record_id",
      "urn_prefix": "urn:apex:evidence:asmodeus:"
    }
  ],
  "integration": {
    "event_types": [
      "apex.asmodeus.exercise.v1"
    ],
    "produces": [
      "exercise-state",
      "detection-observation",
      "mttd-mttr-evidence"
    ]
  },
  "safety": {
    "synthetic_only": true,
    "gateway_may_not_bypass_safety": true
  },
  "observability": {
    "w3c_trace_context": true,
    "otel_resource_attribute": "apex.system",
    "apex_system_value": "asmodeus"
  },
  "supply_chain": {
    "sbom_required": true,
    "sha256_required": true,
    "signature_required_for_production_promotion": true,
    "provenance_required_for_production_promotion": true
  }
}
